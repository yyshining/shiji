<template name="entries"><view wx:for="{{items}}" wx:key="id" class="entry" bindtap="edit" data-id="{{item.id}}" data-kind="{{item.kind}}"><view class="entry-dot"><m-icon name="{{item.icon}}" size="19" color="#648450"/></view><view class="card"><view class="row"><view class="grow"><view class="small">{{item.kindName}} · {{item.time || item.date}}</view><view class="bold">{{item.displayTitle}}</view><view class="entry-body">{{item.body || item.note || item.place}}</view><view wx:if="{{item.kind==='stay'}}" class="small">{{item.date}} → {{item.checkout}}</view></view><image wx:if="{{item.photos.length}}" src="{{item.photos[0]}}" mode="aspectFill"/></view></view></view><view wx:if="{{!items.length}}" class="empty">这一天还没有记录</view></template>
<m-nav wx:if="{{trip}}" title="{{trip.title}}" subtitle="{{tripRange}}" menu bindmenu="menu"/><view wx:if="{{trip}}" class="page">
 <view class="tabs"><button class="{{tab==='overview'?'on':''}}" bindtap="tab" data-id="overview">概览</button><button class="{{tab==='days'?'on':''}}" bindtap="tab" data-id="days">日程</button><button class="{{tab==='ledger'?'on':''}}" bindtap="tab" data-id="ledger">账本</button></view>
 <block wx:if="{{tab==='overview'}}"><view wx:if="{{atlas && trip.status!=='past'}}" class="atlas"><image class="atlas-image" src="{{atlas.src}}" mode="aspectFit"/><view class="atlas-heading"><text>山野之间</text><view>{{mapZoom?'康定周边':'川西旅程'}}</view></view><button class="atlas-zoom" bindtap="mapZoom">{{mapZoom?'↗':'↙'}}<text>{{mapZoom?'全程':'局部'}}</text></button><button wx:for="{{atlas.points}}" wx:key="id" class="atlas-point {{item.selected?'on':''}}" style="left:{{item.x}}%;top:{{item.y}}%;" bindtap="mapPoint" data-index="{{item.index}}"><view class="atlas-pin">{{item.index+1}}</view><view class="atlas-label">{{item.name}}</view></button><view class="atlas-foot">区域路线</view></view><view wx:else class="cover" bindtap="cover"><image src="{{trip.cover || '/assets/landscape.jpg'}}" mode="aspectFill"/><text>{{trip.caption || '把这一程，留在这里'}}</text><view class="cover-edit">编辑封面 ✎</view></view><view class="stats"><view class="stat"><view class="metric">{{trip.members.length}}</view><text class="small">同行人数</text></view><view class="stat"><view class="metric">{{days.length}}</view><text class="small">旅行天数</text></view><view class="stat"><view class="metric">{{trip.entries.length}}</view><text class="small">旅途记录</text></view><view class="stat"><view class="metric">¥{{total}}</view><text class="small">旅程支出</text></view></view><block wx:if="{{trip.status!=='past' && info}}"><view class="culture-card"><view class="culture-copy"><view class="eyebrow">认识这一程 · {{placeName}}</view><view class="culture-title">目的地 · 风土人情</view><view class="culture-text {{cultureExpanded?'expanded':''}}">{{info.culture.text}}</view><button class="culture-expand" bindtap="expandCulture">{{cultureExpanded?'收起介绍':'展开介绍'}} <m-icon name="right" size="13"/></button></view><image src="/assets/landscape.jpg" mode="aspectFill"/></view><view class="weather-card"><view class="row"><view class="weather-heading"><m-icon name="cloud"/>旅途天气</view><button class="refresh-weather" bindtap="refreshInfo" disabled="{{infoLoading}}" aria-label="刷新天气"><m-icon name="refresh" size="19"/></button></view><view class="weather-meta">{{placeName}} · {{trip.start}} — {{trip.end}}</view><view wx:for="{{weather}}" wx:key="date" class="weather-day"><view>{{item.short}}</view><view class="weather-kind"><m-icon name="cloud" color="#789ba6" size="23"/><text>{{item.label}}</text></view><text class="weather-low">{{item.min}}°</text><view class="weather-track"><view style="left:{{item.left}}%;width:{{item.width}}%;"/></view><text>{{item.max}}°</text></view><view wx:if="{{!weather.length}}" class="weather-empty">{{infoLoading?'正在读取天气':info.weather.text || '这些日期暂无可用天气'}}</view></view></block><view class="notebooks"><view class="card sage" bindtap="notebook" data-kind="checks"><view class="bold">✓ 出发准备　›</view><view class="number">{{done}}<text class="small"> / {{trip.checks.length}}</text></view><view class="progress"><view style="width:{{progress}}%;"/></view></view><view class="card paper" bindtap="notebook" data-kind="diary"><view class="bold">✎ 心情日记　＋</view><view class="diary-preview">{{trip.diary || '这一路，你在想什么？'}}</view></view></view><view class="section row"><view class="title">图片空间 <text class="small">{{photoCount}}</text></view><button class="text-button" bindtap="gallery">查看全部 ›</button></view><view class="photo-grid"><button class="photo-add" bindtap="edit" data-kind="moment">＋</button><view wx:for="{{previewPhotos}}" wx:key="src" class="photo-box" bindtap="edit" data-kind="moment" data-id="{{item.id}}"><image src="{{item.src}}" mode="aspectFill"/></view></view></block>
 <block wx:elif="{{tab==='days'}}"><view class="small">{{trip.status==='past'?'这一程的回忆':'旅途中的每一天'}} · {{days.length}} 天</view><view wx:if="{{trip.status==='past'}}" class="stack"><button wx:for="{{filters}}" wx:key="id" class="chip {{filter===item.id?'selected':''}}" bindtap="filter" data-id="{{item.id}}">{{item.name}}</button></view><scroll-view wx:else scroll-x class="date-strip"><button class="date {{!selected?'selected':''}}" bindtap="day" data-date="">总览</button><button wx:for="{{days}}" wx:key="date" class="date {{selected===item.date?'selected':''}}" bindtap="day" data-date="{{item.date}}"><view>{{item.short}}</view><text class="date-weekday">{{item.weekday}}</text></button></scroll-view>
  <block wx:if="{{trip.status==='past'}}"><view wx:for="{{summary}}" wx:key="date" class="archive-day"><view class="row" bindtap="expand" data-date="{{item.date}}"><view><view class="eyebrow">DAY {{item.number}}</view><view class="title">{{item.short}}</view></view><text class="small">{{item.count}} 项　{{expanded===item.date?'⌃':'⌄'}}</text></view><view wx:if="{{expanded===item.date}}" class="stack"><template is="entries" data="{{items:item.entries}}"/><button class="secondary" bindtap="day" data-date="{{item.date}}">选择这一天补记</button></view></view><button class="primary stack" bindtap="add">＋ {{selected?selected+' · ':''}}补充安排或片段</button></block>
  <block wx:elif="{{!selected}}"><view class="section row"><view><view class="eyebrow">整段旅程</view><view class="title">这一程的节奏</view></view><view class="rhythm-duration">{{days.length}}<text>天</text></view></view><view class="rhythm-ticket"><view class="rhythm-legend"><view><text class="kind-0"/>交通</view><view><text class="kind-1"/>住宿</view><view><text class="kind-2"/>体验</view><view><text class="kind-3"/>片段</view></view><scroll-view scroll-x><view class="rhythm-columns"><button wx:for="{{summary}}" wx:key="date" class="rhythm-column {{focus.date===item.date?'focused':''}}" bindtap="focusDay" data-date="{{item.date}}"><text class="rhythm-count">{{item.count}}</text><view class="rhythm-stack"><view wx:for="{{item.segments}}" wx:for-item="segment" wx:key="kind" wx:if="{{segment.count}}" class="segment kind-{{segment.k}}" style="height:{{segment.height}}px;"/><view wx:if="{{!item.count}}" class="rhythm-blank"/></view><text>{{item.short}}</text><text class="rhythm-day">{{item.number}}</text></button></view></scroll-view><view class="rhythm-foot">安排与片段的每日分布</view></view><view wx:if="{{focus}}" class="rhythm-focus"><view class="row"><view><view class="eyebrow">DAY {{focus.number}}</view><view class="title">{{focus.short}}</view></view><button class="round" bindtap="day" data-date="{{focus.date}}"><m-icon name="right" size="20"/></button></view><view class="focus-counts"><text wx:for="{{focus.segments}}" wx:key="kind">{{item.kind==='transfer'?'交通':item.kind==='stay'?'住宿':item.kind==='activity'?'体验':'片段'}} {{item.count}}</text></view><view wx:for="{{focus.entries}}" wx:key="id" wx:if="{{index<2}}" class="focus-preview">{{item.displayTitle}}</view><view wx:if="{{!focus.count}}" class="focus-preview">留一点空白，给路上的惊喜。</view></view></block>
  <block wx:else><view class="section row"><view class="title">{{selected}} <text class="small">{{entries.length}} 项</text></view><button class="round" bindtap="add">＋</button></view><template is="entries" data="{{items:entries}}"/><button class="secondary" bindtap="add">＋ 添加安排或片段</button></block>
 </block>
 <block wx:else><view class="ledger-card"><view class="ledger-label">旅程总支出</view><view class="ledger-total">¥ {{total}}</view><view class="ledger-summary"><view><text>我的分摊</text><view>¥ {{mine}}</view></view><view><text>支出笔数</text><view>{{expenseCount}}</view></view><button bindtap="settlement">分摊结算<m-icon name="right" size="17" color="#ffffff"/></button></view></view><view class="section row"><view class="title">旅行账单</view></view><view wx:for="{{expenseGroups}}" wx:key="date" class="expense-group"><view class="expense-date"><text>{{item.label}}</text><text>¥ {{item.total}}</text></view><button wx:for="{{item.items}}" wx:for-item="expense" wx:key="id" class="expense-row" bindtap="edit" data-kind="expense" data-id="{{expense.id}}"><view class="expense-icon"><m-icon name="{{expense.type==='collection'?'check':'wallet'}}" size="23"/></view><view class="grow"><view class="bold">{{expense.name}}</view><view class="small">{{expense.payer}} · {{expense.people.length}} 人参与{{expense.type==='collection'?' · AA归还':''}}</view></view><text class="bold">{{expense.type==='collection'?'+ ':''}}¥ {{expense.amount}}</text></button></view><view wx:if="{{!expenses.length}}" class="empty"><m-icon name="wallet" size="40"/><view class="title">记下旅行中的第一笔花费</view><view>个人花费选自己，共同支出选同行人。</view></view><view class="ledger-bottom"><button class="primary" bindtap="edit" data-kind="expense"><m-icon name="plus" color="#fff"/>记一笔</button><button class="ai-button" bindtap="assistant"><m-icon name="spark"/>AI</button></view></block>
</view><view wx:if="{{settlementOpen}}" class="overlay" bindtap="closeSettlement"><view class="bottom-sheet" catchtap="noop"><view class="row"><view class="title">分摊结算</view><button class="round" bindtap="closeSettlement"><m-icon name="close"/></button></view><view wx:for="{{balances}}" wx:key="name" class="row balance"><text>{{item.name}}</text><text>{{item.label}} ¥ {{item.amount}}</text></view><button class="primary" bindtap="closeSettlement">完成</button></view></view>