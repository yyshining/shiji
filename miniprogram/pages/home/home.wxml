<view class="home">
 <block wx:if="{{section === 'home'}}">
  <view class="hero-landscape" style="top:{{top}}px;"><image class="hero-image" src="/assets/landscape.jpg" mode="aspectFill"/><view class="hero-wash"/></view>
  <view class="brandbar" style="margin-top:{{top + 32}}px;"><view class="brand"><m-icon name="leaf" size="21"/>拾迹</view><button class="avatar" bindtap="profile">{{profile.name}}</button></view>
  <view class="hero"><view class="hero-copy"><view class="hero-title">走进山野，</view><view class="hero-title accent">拾起每一刻。</view><view class="hero-description"><view>不必写成游记。</view><view>把此刻的心情，留给未来的你。</view></view><view class="eyebrow">SEPTEMBER / 2026</view></view></view>
  <block wx:for="{{trips}}" wx:key="id"><view wx:if="{{item.id===activeId}}" class="active-card"><view class="row"><view class="grow"><text class="pill">● 正在旅途中</text><view class="trip-title">{{item.title}}</view><view class="small">{{item.range}} · {{item.days}} 天</view></view><image class="thumb" src="{{item.cover || '/assets/mountain.jpg'}}" mode="aspectFill"/></view><view class="trip-foot"><view class="duo"><view class="mini-avatar">{{profile.name}}</view><view wx:if="{{item.companion}}" class="mini-avatar">{{item.companionShort}}</view><text>{{item.companion?'和 '+item.companion+' 一起':'独自出发'}}</text></view><button class="continue" bindtap="open" data-id="{{item.id}}">继续这段旅程<m-icon name="right" size="15"/></button></view></view></block>
  <button wx:if="{{activeId}}" class="record-action" bindtap="record" data-id="{{activeId}}"><m-icon name="camera" color="#ffffff"/>记下这一刻</button><button wx:else class="record-action" bindtap="create"><m-icon name="plus" color="#ffffff"/>创建第一段旅程</button>
  <view class="home-pad"><view class="home-section"><view class="section-heading">让旅途轻一点</view><button class="assistant" bindtap="assistant"><m-icon name="spark" size="18"/>旅程助手</button></view><block wx:for="{{trips}}" wx:key="id"><button wx:if="{{item.id===activeId}}" class="ready" bindtap="prepare"><view class="row"><text>出发准备 · 再安心一点</text><text class="bold">{{item.progress}}%</text></view><progress class="progress" percent="{{item.progress}}" stroke-width="4" border-radius="4" activeColor="#648450" backgroundColor="#d5dfca"/></button></block><view class="home-section next-heading"><view class="section-heading">下一次出发</view><button class="add-trip" bindtap="create"><m-icon name="plus" color="#283e30"/></button></view><block wx:for="{{trips}}" wx:key="id"><button wx:if="{{item.status==='planned'}}" class="next-trip" bindtap="open" data-id="{{item.id}}"><image src="{{item.cover || '/assets/camp.jpg'}}" mode="aspectFill"/><view class="grow"><view class="bold">{{item.title}}</view><view class="small">{{item.range}}</view></view><m-icon name="right"/></button></block></view>
 </block>
 <block wx:else><view class="brandbar secondary-brand" style="margin-top:{{top+32}}px;"><view class="brand"><m-icon name="leaf" size="21"/>拾迹</view><button class="avatar" bindtap="profile"><image wx:if="{{profile.avatar}}" src="{{profile.avatar}}" mode="aspectFill"/><text wx:else>{{profile.name}}</text></button></view>
 <view wx:if="{{section==='memories'}}" class="memories-page"><view class="memory-intro">按时间翻阅，你的旅行手帐。</view><view class="memory-filter-row"><text>{{memoryTrips.length}} 段旅程</text><button class="filter-trigger" bindtap="openFilter"><m-icon name="filter" size="15"/>{{filterLabel}}<m-icon name="down" size="13"/></button></view><button wx:for="{{memoryTrips}}" wx:key="id" class="memory-card" bindtap="open" data-id="{{item.id}}"><image src="{{item.cover || '/assets/landscape.jpg'}}" mode="aspectFill"/><view class="memory-caption"><view class="row"><view class="memory-title">{{item.title}}</view><m-icon name="right" size="17"/></view><view class="small">{{item.range}} · {{item.momentCount}} 个片段</view><view class="memory-status">已结束</view></view></button><view wx:if="{{!memoryTrips.length}}" class="memory-empty"><m-icon name="book" size="36"/><view class="memory-title">这一页，还留着空白。</view><button class="secondary" bindtap="resetFilter">查看全部旅程</button></view></view>
 <block wx:else><view class="profile-card"><button class="avatar-button" bindtap="avatar"><image wx:if="{{profile.avatar}}" src="{{profile.avatar}}" mode="aspectFill"/><text wx:else>{{profile.name}}</text><view class="camera-badge"><m-icon name="camera" size="13"/></view></button><view class="grow"><button class="edit-name" bindtap="profile">{{profile.name}}<m-icon name="edit" size="16"/></button><button class="profile-bio" bindtap="editBio">{{profile.bio || '写一句关于自己'}}</button></view></view><view class="profile-stats"><view><text>{{count}}</text><view>段旅程</view></view><view><text>{{moments}}</text><view>个片段</view></view><view><text>{{journals}}</text><view>本手帐</view></view></view><view class="settings"><button class="setting" bindtap="memories"><text>我的旅行手帐</text><m-icon name="right" size="16"/></button><button class="setting" bindtap="importPhotos"><text>导入历史照片</text><m-icon name="right" size="16"/></button><button class="setting" bindtap="companions"><text>同行的人</text><m-icon name="right" size="16"/></button><button class="setting" bindtap="language"><text>语言 / Language</text><text class="setting-hint">简体中文</text><m-icon name="right" size="16"/></button><button class="setting" bindtap="privacy"><text>隐私与分享</text><text class="setting-hint">默认私密</text><m-icon name="right" size="16"/></button><button class="setting" bindtap="sync"><text>云端备份与同步</text><m-icon name="right" size="16"/></button><button class="setting" bindtap="about"><text>关于拾迹</text><m-icon name="right" size="16"/></button><button class="assistant-link" bindtap="assistant"><m-icon name="spark" size="24"/><view class="grow"><view>你的旅程小助手</view><text>陪你准备，帮你整理，留住回忆。</text></view><m-icon name="right" size="16"/></button></view></block></block>
 <view wx:if="{{filterOpen}}" class="sheet-mask" bindtap="closeFilter"><view class="filter-sheet" catchtap="noop"><view class="sheet-handle"/><view class="row"><view class="memory-title">按时间筛选</view><button class="sheet-close" bindtap="closeFilter"><m-icon name="close"/></button></view><view class="filter-label">年份</view><view class="year-chips"><button wx:for="{{years}}" wx:key="*this" class="{{memoryYear===item?'on':''}}" bindtap="chooseYear" data-value="{{item}}">{{index===0?'不限年份':item}}</button></view><view class="row filter-label"><text>月份</text><button bindtap="allMonths">全年</button></view><view class="month-grid"><button wx:for="{{monthCells}}" wx:key="label" class="{{memoryMonth===item.label?'on':''}}" bindtap="chooseMonth" data-value="{{item.label}}"><text>{{item.label}}</text><view>{{item.count?item.count+' 段旅程':'—'}}</view></button></view><view class="button-row filter-actions"><button class="secondary" bindtap="resetFilter">重置</button><button class="primary" bindtap="closeFilter">查看旅程</button></view></view></view>
 <view class="bottom-nav"><button class="{{section==='home'?'on':''}}" bindtap="tab" data-id="home"><m-icon name="pin" size="23" color="{{section==='home'?'#40674d':'#7b8973'}}"/><text>在途</text></button><button class="{{section==='memories'?'on':''}}" bindtap="tab" data-id="memories"><m-icon name="book" size="23" color="{{section==='memories'?'#40674d':'#7b8973'}}"/><text>回忆</text></button><button class="{{section==='profile'?'on':''}}" bindtap="tab" data-id="profile"><m-icon name="user" size="23" color="{{section==='profile'?'#40674d':'#7b8973'}}"/><text>我的</text></button></view>
</view>
