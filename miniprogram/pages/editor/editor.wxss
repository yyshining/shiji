.cover-preview{position:relative;height:350rpx;overflow:hidden;border-radius:32rpx}.cover-preview image{width:100%;height:100%}.cover-preview>view{position:absolute;bottom:0;left:0;right:0;background:#253f3288;color:white;text-align:center;padding:20rpx}.row .field{width:calc(50% - 10rpx)}.picker{font-size:26rpx}checkbox{transform:scale(.8)}

.page{padding:20px 22px 38px}.page>.small{font-size:11px;line-height:1.8;margin-bottom:22px}.field{margin:19px 0}.label{font-size:12px;color:#6e7e69;margin-bottom:8px}.input,.picker{min-height:48px;height:48px;border:1px solid #dfe6d7;border-radius:13px;padding:12px 14px;font-size:14px;background:#fff}.picker{display:flex;align-items:center;justify-content:space-between;gap:5px}.row .picker{font-size:12px;padding:12px 10px}.textarea{font-size:15px;line-height:1.9;background:#fbfaf3;border:1px solid #e2e6d9;border-radius:16px;padding:16px;min-height:160px}.cover-preview{height:175px;border-radius:20px}.cover-preview>view{font-size:12px;background:linear-gradient(transparent,#253f32bb);padding:28px 12px 12px}.primary{min-height:48px;font-size:14px;padding:13px 20px}.photo-grid{margin:22px 0}.photo-add{height:100px}.text-button{font-size:12px}.chip{font-size:12px;padding:8px 10px;margin:4px;border-radius:18px}.error{font-size:12px;border-radius:12px;padding:12px}

.page{padding:6px 22px calc(30px + env(safe-area-inset-bottom))}.input{padding:0 14px;line-height:48px}.expense-editor>.small{display:none}.expense-switch{display:flex;border-radius:26px;background:#e9eee1;padding:4px;margin-bottom:18px}.expense-switch button{flex:1;padding:10px;border-radius:22px;font-size:14px}.expense-switch .on{background:#40674d;color:white}.amount-card{background:#e9eee1;border-radius:22px;padding:18px 20px}.amount-card>text{font-size:11px;letter-spacing:1px;color:#74836e}.amount-display{font-size:28px;margin-top:12px;display:flex;align-items:center;gap:12px}.amount-display text{font-size:42px;line-height:1.3}.expense-note{height:54px;font-size:15px;border-bottom:1px solid #dfe6d7;padding:0 5px;margin:8px 0 16px}.expense-meta{display:flex;gap:8px}.expense-meta>button,.expense-meta>m-picker{flex:1;min-width:0}.expense-meta .secondary{display:flex;align-items:center;justify-content:center;gap:6px;font-size:11px;padding:12px 7px;min-height:42px;white-space:nowrap}.split-caption{font-size:11px;color:#74836e;margin:13px 0}.category-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:7px;margin:16px 0}.category-grid button{display:flex;flex-direction:column;align-items:center;gap:6px;border-radius:15px;padding:10px 4px;font-size:11px}.category-grid .on{background:#e4ecdb;color:#40674d}.number-pad{display:grid;grid-template-columns:repeat(3,1fr);gap:7px;margin:16px 0}.number-pad button{background:#fff;border-radius:14px;height:49px;font-size:24px;display:flex;align-items:center;justify-content:center}.expense-save{margin-top:15px}.expense-save button{font-size:14px}.participant-row{display:flex;align-items:center;justify-content:space-between;padding:18px 0;border-bottom:1px solid #dfe6d7}.participant-name{display:flex;align-items:center;gap:12px;font-size:15px}.person-check{width:22px;height:22px;border-radius:50%;border:1px solid #a9bb99;display:flex;align-items:center;justify-content:center}.person-check.on{background:#40674d}.payer{font-size:11px;background:#e9eee1;border-radius:20px;padding:8px 10px}.payer.on{background:#40674d;color:white}

.number-pad button,.category-grid button{width:100%!important}.expense-meta>button,.expense-meta>m-picker{width:0!important;flex:1}.expense-meta m-picker .secondary{width:100%!important}
