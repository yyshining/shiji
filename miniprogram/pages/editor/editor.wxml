<m-nav title="{{pageTitle || ''}}"/>
<view class="page {{kind==='expense'?'expense-editor':''}}">
 <view wx:if="{{trip && kind!=='trip'}}" class="small">{{trip.title}} · {{trip.start}} — {{trip.end}}</view>
 <block wx:if="{{kind==='trip'}}"><view class="field"><text class="label">旅程名称</text><input class="input" value="{{form.title}}" data-key="title" bindinput="field" maxlength="40" placeholder="给这段旅程起个名字"/></view><view class="row"><view class="field grow"><text class="label">出发日期</text><m-picker mode="date" value="{{form.start}}" bindchange="field" data-key="start"><view class="picker">{{form.start}}<m-icon name="down" size="15"/></view></m-picker></view><view class="field grow"><text class="label">结束日期</text><m-picker mode="date" value="{{form.end}}" bindchange="field" data-key="end"><view class="picker">{{form.end}}<m-icon name="down" size="15"/></view></m-picker></view></view><view class="field"><text class="label">同行人（顿号分隔）</text><input class="input" value="{{form.memberText}}" data-key="memberText" bindinput="field" maxlength="100"/></view></block>
 <block wx:elif="{{kind==='cover'}}"><view class="cover-preview stack" bindtap="cover"><image src="{{form.cover || '/assets/landscape.jpg'}}" mode="aspectFill"/><view>点击更换封面</view></view><view class="field"><text class="label">旅程名称</text><input class="input" value="{{form.title}}" data-key="title" bindinput="field" maxlength="40"/></view><view class="field"><text class="label">封面文字</text><input class="input" value="{{form.caption}}" data-key="caption" bindinput="field" maxlength="40"/></view></block>
 <block wx:else>
  <block wx:if="{{kind==='expense'}}"><view class="expense-switch"><button class="{{typeIndex===0?'on':''}}" bindtap="setType" data-index="0">旅行支出</button><button class="{{typeIndex===1?'on':''}}" bindtap="setType" data-index="1">收回 AA 款</button></view><view class="amount-card"><text>人民币 · CNY</text><view class="amount-display">¥ <text>{{form.amount || '0.00'}}</text></view></view><input class="expense-note" value="{{form.name}}" data-key="name" bindinput="field" placeholder="添加用途或备注" maxlength="60"/><view class="expense-meta"><button class="secondary" bindtap="openPeople"><m-icon name="user" size="17"/>{{form.people.length}} 人参与<m-icon name="down" size="14"/></button><m-picker mode="date" value="{{form.date}}" data-key="date" bindchange="field"><view class="secondary"><m-icon name="calendar" size="17"/>{{form.date}}<m-icon name="down" size="14"/></view></m-picker></view><view class="split-caption">{{form.payer}} {{typeIndex===0?'付款 · 所选参与人均摊':'收款 · 不计入旅行支出'}}</view><view wx:if="{{typeIndex===0}}" class="category-grid"><button wx:for="{{categories}}" wx:key="id" class="{{form.category===item.id?'on':''}}" bindtap="category" data-id="{{item.id}}"><m-icon name="{{item.icon}}" size="21"/><text>{{item.name}}</text></button></view><view class="number-pad"><button wx:for="{{keys}}" wx:key="*this" bindtap="amountKey" data-key="{{item}}">{{item}}</button></view></block>
  <block wx:else>
  <view class="field"><text class="label">{{kind==='stay'?'入住日期':'日期'}}</text><m-picker mode="date" value="{{form.date}}" start="{{kind==='expense'?'':trip.start}}" end="{{kind==='expense'?'':trip.end}}" bindchange="field" data-key="date"><view class="picker">{{form.date}}<m-icon name="down" size="15"/></view></m-picker></view>
   <block wx:if="{{kind==='transfer'}}"><view class="field"><text class="label">出发地</text><input class="input" value="{{form.from}}" data-key="from" bindinput="field" maxlength="60"/></view><view class="field"><text class="label">目的地</text><input class="input" value="{{form.to}}" data-key="to" bindinput="field" maxlength="60"/></view><view class="field"><text class="label">交通方式 / 车次</text><input class="input" value="{{form.method}}" data-key="method" bindinput="field" maxlength="60"/></view></block>
   <view wx:else class="field"><text class="label">{{kind==='stay'?'住处名称':kind==='activity'?'想做什么':'标题'}}</text><input class="input" value="{{form.title}}" data-key="title" bindinput="field" maxlength="80" placeholder="{{kind==='moment'?'路上的一刻':'写下名称'}}"/></view>
   <view wx:if="{{kind==='stay'}}" class="field"><text class="label">离店日期</text><m-picker mode="date" value="{{form.checkout}}" bindchange="field" data-key="checkout"><view class="picker">{{form.checkout}}<m-icon name="down" size="15"/></view></m-picker></view>
   <view class="field"><text class="label">时间（选填）</text><m-picker mode="time" value="{{form.time}}" bindchange="field" data-key="time"><view class="picker">{{form.time || '选择时间'}}<m-icon name="down" size="15"/></view></m-picker></view>
   <view wx:if="{{kind!=='transfer'}}" class="field"><text class="label">地点 / 地址</text><input class="input" value="{{form.place}}" data-key="place" bindinput="field" maxlength="120"/></view>
   <view class="field"><text class="label">{{kind==='moment'?'留下此刻的心情':'备注'}}</text><textarea class="textarea" auto-height value="{{form.body}}" data-key="body" bindinput="field" maxlength="5000" placeholder="慢慢写，不必写成游记。"/></view>
   <view wx:if="{{kind==='moment'}}" class="photo-grid"><view wx:for="{{form.photos}}" wx:key="*this" class="photo-box"><image src="{{item}}" mode="aspectFill"/><button class="delete-photo" catchtap="removePhoto" data-index="{{index}}">×</button></view><button wx:if="{{form.photos.length<9}}" class="photo-add" bindtap="addPhotos" disabled="{{busy}}">＋</button></view>
  </block>
 </block>
 <view wx:if="{{error}}" class="error">{{error}}</view><view wx:if="{{kind==='expense'}}" class="button-row expense-save"><button class="secondary" bindtap="save" disabled="{{busy}}">保存并退出</button><button class="primary" bindtap="saveMore" disabled="{{busy}}">再记一笔</button></view><button wx:else class="primary stack" bindtap="save" disabled="{{busy}}" loading="{{busy}}">保存</button><button wx:if="{{entry}}" class="text-button danger stack" bindtap="remove">删除这条记录</button>
</view>
<view wx:if="{{peopleOpen}}" class="overlay" bindtap="closePeople"><view class="bottom-sheet" catchtap="noop"><view class="row"><view class="title">参与人与{{typeIndex===0?'付款人':'收款人'}}</view><button class="round" bindtap="closePeople"><m-icon name="close"/></button></view><view wx:for="{{people}}" wx:key="name" class="participant-row"><button class="participant-name" bindtap="togglePerson" data-name="{{item.name}}"><view class="person-check {{item.checked?'on':''}}"><m-icon wx:if="{{item.checked}}" name="check" size="14" color="#fff"/></view><text>{{item.name}}</text></button><button class="payer {{form.payer===item.name?'on':''}}" bindtap="setPayer" data-name="{{item.name}}">{{form.payer===item.name?(typeIndex===0?'付款人':'收款人'):'设为'+(typeIndex===0?'付款人':'收款人')}}</button></view><button class="primary stack" bindtap="closePeople">确认参与人</button></view></view>