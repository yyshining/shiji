<m-nav title="把旧照片，带回旅程"/>
<view class="page"><view class="intro">选择同一天的照片，放回属于它们的旅程。</view><block wx:if="{{trip}}"><view class="field"><view class="label">放进哪段旅程</view><button class="trip-choice" bindtap="open"><view class="choice-icon"><m-icon name="book"/></view><view class="grow"><view class="choice-title">{{trip.title}}</view><view class="small">{{trip.start}} — {{trip.end}}</view></view><m-icon name="down" size="17"/></button></view><view class="field"><view class="label">照片拍摄日期</view><m-picker mode="date" start="{{trip.start}}" end="{{trip.end}}" value="{{date}}" bindchange="date"><view class="trip-choice"><view class="choice-icon"><m-icon name="calendar"/></view><view class="grow choice-title">{{date}}</view><m-icon name="right" size="17"/></view></m-picker></view><button class="primary continue" bindtap="next">选择这一组照片</button></block><block wx:else><view class="empty">先创建一段旅程，再把照片放进去。</view><button class="primary" bindtap="create">创建旅程</button></block></view>
<view wx:if="{{choosing}}" class="mask" bindtap="close"><view class="sheet" catchtap="noop"><view class="handle"/><view class="sheet-title">放进哪段旅程</view><scroll-view scroll-y class="trip-list"><button wx:for="{{trips}}" wx:key="id" bindtap="select" data-id="{{item.id}}" class="trip-option {{item.id===trip.id?'selected':''}}"><image src="{{item.cover || '/assets/landscape.jpg'}}" mode="aspectFill"/><view class="grow"><view>{{item.title}}</view><text>{{item.start}} — {{item.end}}</text></view><m-icon wx:if="{{item.id===trip.id}}" name="check" size="19"/></button></scroll-view><button class="cancel" bindtap="close">取消</button></view></view>
