.page{padding:24px 22px}.intro{font-size:13px;line-height:1.8;color:#6e7e69;margin:8px 0 26px}.label{font-size:13px;margin-bottom:9px}.trip-choice{display:flex;align-items:center;gap:12px;width:100%!important;text-align:left;background:white;border:1px solid #dfe6d7;border-radius:16px;padding:16px 14px;margin:0!important}.choice-icon{display:flex;align-items:center;justify-content:center;width:36px;height:36px;border-radius:12px;background:#edf2e5}.choice-title{font-size:14px}.small{font-size:10px;margin-top:4px}.continue{margin-top:32px!important;min-height:48px;font-size:14px}.mask{position:fixed;inset:0;background:#23372c66;display:flex;align-items:flex-end;z-index:20}.sheet{width:100%;background:#f6f8f1;border-radius:24px 24px 0 0;padding:10px 20px max(18px,env(safe-area-inset-bottom))}.handle{width:32px;height:3px;background:#ccd6c3;border-radius:4px;margin:0 auto 18px}.sheet-title{font:21px 'Songti SC',serif;margin-bottom:18px}.trip-list{max-height:400px}.trip-option{display:flex;align-items:center;gap:12px;padding:12px;text-align:left;width:100%!important;margin:0 0 8px!important;border:1px solid transparent;border-radius:15px;font-size:13px}.trip-option.selected{background:#e9eee1;border-color:#c4d3b7}.trip-option image{width:43px;height:48px;border-radius:10px}.trip-option text{font-size:10px;color:#73836b}.cancel{min-height:48px;font-size:14px;color:#6e7e69}
