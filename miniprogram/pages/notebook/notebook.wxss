.moods{display:flex;flex-wrap:wrap;margin:34rpx 0}.mood{width:25%;padding:16rpx;border-radius:24rpx}.mood>view{width:78rpx;height:78rpx;border-radius:45% 48% 40% 43%;margin:0 auto 12rpx;font-size:46rpx;line-height:78rpx}.mood.selected{background:#e9eee1}.font-row{text-align:right}.letter{margin-top:18rpx;padding:32rpx;background:#faf6e9;border:2rpx solid #e9dfc8;border-radius:22rpx;min-height:560rpx}.letter textarea{width:100%;min-height:430rpx;font-size:34rpx;line-height:70rpx;background:repeating-linear-gradient(transparent,transparent 68rpx,#ddd3bb 69rpx,transparent 70rpx)}.hand{font-family:KaiTi,"Kaiti SC",STKaiti,serif}.serif{font-family:"Songti SC",serif}.simple{font-family:sans-serif}.stamp{display:flex;align-items:center;gap:18rpx;margin-bottom:20rpx}.stamp>text:first-child{font-size:64rpx}.checks{padding:12rpx 28rpx 28rpx}.check-row{position:relative;display:flex;align-items:center;gap:20rpx;min-height:118rpx;background:#fff;border-bottom:2rpx solid #dfe6d7}.check{width:46rpx;height:46rpx;border:2rpx solid #b1c2a2;border-radius:50%;line-height:42rpx;flex-shrink:0}.checked{background:#40674d;color:white;border-color:#40674d}.done{text-decoration:line-through;color:#89967e}.handle{padding:26rpx 14rpx;color:#a1b093;font-size:42rpx;touch-action:none}.dragging{z-index:3;box-shadow:0 10rpx 32rpx #29452933;border-radius:20rpx;background:#f1f5ea}.progress{margin-top:24rpx;height:8rpx;background:#d5dfca}.progress>view{height:100%;background:#648450}.new-input{height:88rpx;font-size:28rpx}

/* Match the Web notebook: ink faces, restrained controls and ruled paper. */
.moods{display:grid;grid-template-columns:repeat(4,1fr);gap:10px 6px;margin:24px 0}.mood{width:100%!important;min-height:70px;padding:5px 2px;border:1px solid transparent;border-radius:14px;margin:0!important}.mood>view{width:37px;height:35px;line-height:normal;margin:0 auto 7px;border-radius:48% 46% 40% 44%;display:flex;align-items:center;justify-content:center}.mood image{width:29px;height:29px}.mood.selected{border-color:#a5ba97;background:#eef3e7}.mood .small{font-size:11px}.font-row{display:flex;align-items:center;gap:5px;margin-bottom:12px}.font-mark{font:italic 20px Georgia,serif;margin-right:auto;color:#7e876e}.font-row .chip{margin:0!important;padding:7px 13px;font-size:12px;border-radius:20px;min-height:40px}.letter{margin-top:0;padding:19px 20px 15px;border:1px solid #e6ddc9;border-radius:4px 16px 16px 4px;background:#fbf7eb;box-shadow:inset 5px 0 #ede5d3;min-height:400px;color:#615d46}.letter textarea{min-height:288px;font-size:18px;line-height:36px;letter-spacing:.5px;background:repeating-linear-gradient(transparent 0,transparent 35px,#ddd3bb 35px,#ddd3bb 36px);color:#615d46}.simple textarea{font-size:16px}.stamp{min-height:40px;gap:9px;margin-bottom:16px;font:14px 'Songti SC',serif;color:#615d46}.stamp-face{width:39px;height:38px;border-radius:48% 46% 40% 44%;display:flex;align-items:center;justify-content:center}.stamp image{width:30px;height:30px}.signature{text-align:right;font-size:10px;letter-spacing:2px;color:#9a977f;margin-top:16px}.check-row{transition:transform 180ms ease}.check-row.dragging{transition:none}.check{margin:0!important;width:23px!important;padding:0}.handle{flex-shrink:0}
