<m-nav title="{{kind==='checks'?'出发准备':'心情日记'}}"/>
<view class="page"><view class="bold">{{trip.title}}</view><view class="small">{{trip.start}} — {{trip.end}}</view>
 <block wx:if="{{kind==='checks'}}"><view class="card sage stack"><view class="row"><view><view class="bold">准备好，安心出发。</view><view class="small">{{done}} / {{trip.checks.length}} 项已完成</view></view><view class="title">{{progress}}%</view></view><view class="progress"><view style="width:{{progress}}%;"/></view></view><view class="card checks"><view wx:for="{{trip.checks}}" wx:key="id" class="check-row {{drag===index?'dragging':''}}" style="transform:translateY({{drag===index?rowY:(drag>=0&&index>drag&&index<=dragTarget?-rowHeight:(drag>=0&&index<drag&&index>=dragTarget?rowHeight:0))}}px);"><button class="check {{item.done?'checked':''}}" bindtap="check" data-id="{{item.id}}">{{item.done?'✓':''}}</button><view class="grow {{item.done?'done':''}}" bindtap="rename" data-id="{{item.id}}">{{item.name}}</view><view class="handle" data-index="{{index}}" bindtouchstart="startDrag" catchtouchmove="moveDrag" bindtouchend="endDrag" bindtouchcancel="cancelDrag">⠿</view></view><view class="row stack"><input class="grow new-input" value="{{newItem}}" bindinput="inputNew" bindconfirm="add" confirm-type="done" placeholder="添加准备事项" maxlength="80"/><button class="round" bindtap="add">＋</button></view></view></block>
 <block wx:else><view class="moods"><button wx:for="{{moods}}" wx:key="name" class="mood {{trip.mood===item.name?'selected':''}}" data-name="{{item.name}}" bindtap="mood"><view style="background:{{item.color}};"><image src="{{item.image}}"/></view><text class="small">{{item.name}}</text></button></view><view class="font-row"><text class="font-mark">Aa</text><button class="chip {{trip.font==='hand'?'selected':''}}" bindtap="font" data-id="hand">手写</button><button class="chip {{trip.font==='serif'?'selected':''}}" bindtap="font" data-id="serif">宋体</button><button class="chip {{trip.font==='simple'?'selected':''}}" bindtap="font" data-id="simple">简洁</button></view><view class="letter {{trip.font}}"><view wx:if="{{selectedMood}}" class="stamp"><view class="stamp-face" style="background:{{selectedMood.color}};"><image src="{{selectedMood.image}}"/></view><text>{{selectedMood.name}}</text></view><textarea value="{{trip.diary}}" auto-height bindinput="inputDiary" maxlength="10000" placeholder="亲爱的自己，\n今天想记住什么？" cursor-spacing="40"/><view class="signature">拾迹 · 心情手记</view></view><view wx:if="{{error}}" class="error" bindtap="retry">{{error}} 点击重试</view></block>
</view>
