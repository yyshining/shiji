page{background:#f6f8f1;color:#283e30;font-family:-apple-system,"PingFang SC",sans-serif;font-size:28rpx;line-height:1.6}view,button,input,textarea{box-sizing:border-box}button{margin:0;padding:0;background:none;color:inherit;font-size:28rpx;line-height:1.6;border-radius:0}button::after{border:0}button[disabled]{opacity:.5}input,textarea{font:inherit;color:inherit}image{display:block} .page{padding:32rpx 40rpx 100rpx}.title{font-family:"Songti SC",STSong,serif;font-size:48rpx;font-weight:500;line-height:1.45}.small{font-size:24rpx;color:#74836e}.eyebrow{font-size:22rpx;letter-spacing:3rpx;color:#718764}.row{display:flex;align-items:center;justify-content:space-between;gap:20rpx}.grow{flex:1;min-width:0}.stack{margin-top:30rpx}.card{background:#fff;border-radius:36rpx;padding:32rpx;margin-bottom:24rpx}.sage{background:#e9eee1}.primary{background:#40674d;color:#fff;border-radius:60rpx;padding:24rpx 32rpx;text-align:center;min-height:92rpx}.secondary{background:#e9eee1;border-radius:50rpx;padding:20rpx 28rpx;min-height:88rpx}.text-button{color:#40674d;min-height:88rpx;display:flex;align-items:center;justify-content:center;padding:12rpx 20rpx}.round{background:#e5ecdc;border-radius:50%;width:88rpx;height:88rpx;display:flex;align-items:center;justify-content:center;font-size:44rpx;flex-shrink:0}.pill{padding:8rpx 18rpx;border-radius:40rpx;background:#e8efdf;color:#4c7042;font-size:22rpx}.tabs{display:flex;background:#ebefe5;border:2rpx solid #dfe6d7;border-radius:60rpx;padding:8rpx;margin:26rpx 0}.tabs button{flex:1;border-radius:50rpx;padding:18rpx 4rpx}.tabs .on{background:#40674d;color:#fff}.section{margin:42rpx 0 20rpx}.section .title{font-size:38rpx}.field{display:block;margin:28rpx 0}.label{display:block;font-size:26rpx;margin-bottom:12rpx;color:#65765e}.input,.picker{background:#fff;border:2rpx solid #e1e7da;border-radius:22rpx;padding:20rpx 24rpx;width:100%;min-height:94rpx}.input{height:94rpx}.textarea{background:#fff;border:2rpx solid #e1e7da;border-radius:24rpx;width:100%;min-height:260rpx;padding:24rpx;line-height:1.9}.empty{padding:60rpx 22rpx;text-align:center;color:#74836e}.error{background:#f8e8e1;color:#8a463b;border-radius:18rpx;padding:20rpx;margin:20rpx 0}.photo-grid{display:flex;flex-wrap:wrap;gap:16rpx}.photo-box{position:relative;width:calc((100% - 32rpx)/3)}.photo-box image,.photo-add{width:100%;height:200rpx;border-radius:22rpx}.photo-add{width:calc((100% - 32rpx)/3);background:#e9eee1;border:2rpx dashed #bbccad;display:flex;align-items:center;justify-content:center;color:#638651;font-size:42rpx}.delete-photo{position:absolute;right:4rpx;top:4rpx;background:#fff;border-radius:50%;width:48rpx;height:48rpx}.divider{border-top:2rpx solid #e1e7da;margin:24rpx 0}.stats{display:flex;text-align:center;margin:30rpx 0}.stat{flex:1;border-right:2rpx solid #dfe6d7}.stat:last-child{border:0}.stat .metric{display:block;font-size:38rpx;font-weight:600}.chip{display:inline-block;padding:14rpx 22rpx;margin:6rpx;background:#e9eee1;border-radius:40rpx;color:#647859}.chip.selected{background:#40674d;color:#fff}.bottom-space{height:50rpx}.danger{color:#9b4f40}.bold{font-weight:600}.entry-body{white-space:pre-wrap;color:#6e7e69;margin-top:10rpx}.button-row{display:flex;gap:16rpx}.button-row button{flex:1}
/* Reset WeChat's default button width and bold weight before applying product styles. */
button{font-weight:400}button:not([size='mini']){width:auto;margin:0}.primary,.secondary{width:100%!important}.photo-add{width:calc((100% - 32rpx)/3)!important}.round{width:88rpx!important}.delete-photo{width:48rpx!important}

button.primary[disabled],button.secondary[disabled]{background:#e2e8da!important;color:#71816b!important;opacity:1}

page{width:100%;overflow-x:hidden}.overlay{position:fixed;left:0;right:0;top:0;bottom:0;z-index:950;background:rgba(30,48,36,.38);display:flex;align-items:flex-end}.bottom-sheet{box-sizing:border-box;width:100%;max-height:85vh;overflow:auto;background:#f6f8f1;border-radius:28px 28px 0 0;padding:24px 22px calc(24px + env(safe-area-inset-bottom))}.bottom-sheet .title{font-size:22px}.bottom-sheet .round{width:40px!important;height:40px;background:white}.input{line-height:normal;padding-top:0;padding-bottom:0}scroll-view{box-sizing:border-box}
