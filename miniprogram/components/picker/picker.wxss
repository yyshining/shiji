.control{margin:0;padding:0;background:none;color:#283e30;font-size:14px;line-height:1.5}.control:after{border:0}.mask{position:fixed;inset:0;width:100%;height:100%;z-index:1000;background:rgba(30,48,36,.38);display:flex;align-items:flex-end}.sheet{width:100%;box-sizing:border-box;background:#f6f8f1;border-radius:28px 28px 0 0;padding:9px 22px calc(22px + env(safe-area-inset-bottom));max-height:85vh}.handle{width:36px;height:4px;border-radius:4px;background:#d5dfca;margin:0 auto 16px}.heading{display:flex;align-items:center;justify-content:space-between;font:22px 'Songti SC',serif;margin-bottom:16px}.heading .control,.month .control{width:40px;height:40px;border-radius:50%;background:#fff;display:flex;align-items:center;justify-content:center}.month{display:flex;align-items:center;justify-content:space-between;margin:8px 0 18px}.grid{display:grid;grid-template-columns:repeat(7,1fr);gap:5px}.week{text-align:center;font-size:12px;color:#7b8973;margin-bottom:8px}.day{height:40px;display:flex;align-items:center;justify-content:center;border-radius:13px}.day.disabled{color:#bdc5b7;background:transparent}.on{background:#40674d!important;color:#fff!important}.confirm{background:#40674d;color:#fff;padding:14px;border-radius:30px;margin-top:22px}.options{max-height:48vh}.option{display:flex;align-items:center;justify-content:space-between;text-align:left;background:white;padding:16px;border-radius:16px;margin:8px 0}.selected{background:#e5ecdc}.time-value{text-align:center;font-size:32px;margin:10px}.time-columns{display:flex;gap:18px}.time-scroll{height:240px;flex:1;width:0}.time-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:5px}.time-grid .control{padding:10px 0;border-radius:12px;background:white}.label{font-size:12px;color:#74836e;padding:10px}
.control{box-sizing:border-box;width:auto!important;font-weight:400}.heading .control,.month .control{flex:0 0 40px;min-width:40px}.option,.confirm{width:100%!important}.day{width:100%!important}.disabled{opacity:.45}

.control{margin:0!important}.time-button{width:100%!important}
