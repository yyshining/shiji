<view bindtap="show"><slot/></view><view wx:if="{{open}}" class="mask" catchtouchmove="noop" bindtap="close"><view class="sheet" catchtap="noop"><view class="handle"/><view class="heading"><text>{{mode==='date'?'选择日期':mode==='time'?'选择时间':title}}</text><button class="control" bindtap="close" aria-label="关闭"><m-icon name="close" size="20"/></button></view><block wx:if="{{mode==='date'}}"><view class="month"><button class="control" bindtap="move" data-step="-1"><m-icon name="back" size="20"/></button><text>{{year}} 年 {{month}} 月</text><button class="control" bindtap="move" data-step="1"><m-icon name="right" size="20"/></button></view><view class="grid week"><text wx:for="{{week}}" wx:key="*this">{{item}}</text></view><view class="grid"><button  wx:for="{{cells}}" wx:key="key" class="control day {{item.disabled?'disabled':''}} {{draft===item.date?'on':''}}" disabled="{{item.disabled}}" bindtap="date" data-date="{{item.date}}" data-disabled="{{item.disabled}}">{{item.n}}</button></view></block><block wx:elif="{{mode==='time'}}"><view class="time-value">{{hour}} : {{minute}}</view><view class="time-columns"><scroll-view scroll-y class="time-scroll"><view class="label">小时</view><view class="time-grid"><button  wx:for="{{hours}}" wx:key="*this" class="control time-button {{hour===item?'on':''}}" data-part="hour" data-value="{{item}}" bindtap="time">{{item}}</button></view></scroll-view><scroll-view scroll-y class="time-scroll"><view class="label">分钟</view><view class="time-grid"><button  wx:for="{{minutes}}" wx:key="*this" class="control time-button {{minute===item?'on':''}}" data-part="minute" data-value="{{item}}" bindtap="time">{{item}}</button></view></scroll-view></view></block><scroll-view wx:else scroll-y class="options"><button  wx:for="{{options}}" wx:key="index" bindtap="choice" data-index="{{item.index}}" class="control option {{value==item.index?'selected':''}}"><text>{{item.label}}</text><m-icon wx:if="{{value==item.index}}" name="check" size="19"/></button></scroll-view><button  wx:if="{{mode==='date'||mode==='time'}}" class="control confirm" bindtap="confirm">确定</button></view></view>